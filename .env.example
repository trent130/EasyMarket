# Django Core
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave DB_NAME empty to use SQLite for local dev)
DB_NAME=easymarket
DB_USER=easymarket_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (optional — leave empty to use in-memory fallbacks)
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (leave empty to use console backend for local dev)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# M-Pesa Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_EXPRESS_SHORTCODE=174379
MPESA_SHORTCODE_TYPE=paybill
MPESA_PASSKEY=
MPESA_INITIATOR_USERNAME=
MPESA_INITIATOR_SECURITY_CREDENTIALS=
MPESA_CALLBACK_URL=mpesa_callback

# Payment
PAYMENT_HOST=http://localhost:8000
